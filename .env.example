# Copy this file to .env and paste your keys after the = signs.
# .env is gitignored and must be chmod 600. Never commit it.
#
#   cp .env.example .env && chmod 600 .env && ${EDITOR:-nano} .env
#
# Only TYPESAFE_API_KEY is needed for Jev routing and ranking.

TYPESAFE_API_KEY=
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
