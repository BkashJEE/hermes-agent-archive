{
  "name": "hermes-agent-archive",
  "version": "1.0.0",
  "private": true,
  "description": "A community archive of sourced Hermes Agent workflows, prompts, skills and integrations.",
  "type": "module",
  "scripts": {
    "key": "node scripts/set-key.mjs",
    "start": "python3 -m http.server 4179 --bind 127.0.0.1",
    "fetch": "node scripts/fetch-signals.mjs",
    "route": "node scripts/route-signals.mjs",
    "sync": "npm run fetch && npm run route",
    "rank": "node scripts/rank-archive.mjs",
    "check": "node scripts/check-data.mjs",
    "rank:ideas": "node scripts/rank-with-jev.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
